<?xml version="1.0" encoding="utf-8"?>
<!--
  MUST PASS.
  Guards against over-correction: existing valid 2010/01 structures (ReportSections /
  ReportSection / Body) must continue to pass. These are valid in 2010 and must NOT be
  flagged by the schema-compatibility check.
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="MainOSIConnect">
      <DataSourceReference>MainOSIConnect</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Title">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Daily Billed Orders</Value>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
          </Textbox>
        </ReportItems>
        <Height>1in</Height>
      </Body>
      <Width>6.5in</Width>
    </ReportSection>
  </ReportSections>
</Report>
